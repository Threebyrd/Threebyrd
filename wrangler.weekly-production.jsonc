{
 "name":"threebyrd-weekly-production",
 "account_id":"4be3efc46385a4a26f3f303384bd97aa",
 "main":"app/subscriptions/production/worker.mjs",
 "compatibility_date":"2026-10-21",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":true,
 "routes":[{"pattern":"weekly.threebyrd.com","custom_domain":true}],
 "vars":{"WEEKLY_BILLING_ENABLED":"true","WEEKLY_CUSTOMER_EMAILS_ENABLED":"false"},
 "send_email":[{"name":"EMAIL","allowed_destination_addresses":["luc@threebyrd.com"]}],
 "assets":{"directory":".local-previews/weekly-production/site","binding":"ASSETS","run_worker_first":true,"html_handling":"none"},
 "rules":[{"type":"Text","globs":["**/*.sql"],"fallthrough":true}],
 "durable_objects":{"bindings":[{"name":"WEEKLY_PRODUCTION","class_name":"WeeklyProduction"}]},
 "migrations":[{"tag":"weekly-production-v1","new_sqlite_classes":["WeeklyProduction"]}],
 "observability":{"enabled":true,"logs":{"enabled":true,"invocation_logs":false}}
}
